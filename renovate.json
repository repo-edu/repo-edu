{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Amsterdam",
  "schedule": ["* * * * 0,6"],
  "dependencyDashboard": {
    "enabled": true
  },
  "branchConcurrentLimit": 4,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "automerge": true,
  "automergeType": "branch",
  "automergeStrategy": "fast-forward",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "updateNotScheduled": false,
    "schedule": ["* * * * 0"],
    "minimumReleaseAge": null
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0
  },
  "packageRules": [
    {
      "description": "Non-major updates outside the narrower groups below: one branch for product and tool libraries, so a new dependency is grouped without a config edit",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "libraries"
    },
    {
      "description": "Development tooling: lint, format, type-check, test and build tools that never ship in the app, so their failures show in the checks and not in the product",
      "matchPackageNames": [
        "@biomejs/biome",
        "rumdl",
        "husky",
        "tsx",
        "bun",
        "pnpm",
        "globby",
        "esbuild",
        "typescript",
        "@typescript/**",
        "@types/**",
        "@playwright/test",
        "happy-dom",
        "dependency-cruiser",
        "@faker-js/faker"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "dev tooling"
    },
    {
      "description": "CI actions and the Git server images of the integration tests join development tooling: they never ship in the app either",
      "matchManagers": ["github-actions", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "dev tooling"
    },
    {
      "description": "React stack of renderer-app and ui: matched by package name because a package declared in several manifests would otherwise split over two branches",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@radix-ui/**",
        "@dnd-kit/**",
        "@tanstack/**",
        "tailwindcss",
        "@tailwindcss/**",
        "tailwind-merge",
        "class-variance-authority",
        "clsx",
        "lucide-react",
        "recharts",
        "react-resizable-panels",
        "zustand",
        "immer",
        "shiki",
        "@shikijs/**"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "renderer ui"
    },
    {
      "description": "Docs site: matched by manifest because its packages appear in no other one, and a failure there cannot reach the app",
      "matchFileNames": ["apps/docs/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "docs site"
    },
    {
      "description": "Electron runtime patch/minor updates: weekly with a short maturity window because Electron carries Chromium and has a short support cycle",
      "matchPackageNames": ["electron"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "electron runtime non-major",
      "schedule": ["* 0-4 * * 1"],
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Peer-coupled Anthropic and MCP SDKs: grouped for every update type so they move in lockstep",
      "matchPackageNames": ["@anthropic-ai/**", "@modelcontextprotocol/sdk"],
      "groupName": "llm sdks"
    },
    {
      "description": "Codex SDK non-major updates join the LLM SDKs: a failure shows in the same LLM integration, while its major updates keep their own branch",
      "matchPackageNames": ["@openai/codex-sdk"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "llm sdks"
    },
    {
      "description": "Major bumps: wait 30 days for the release to mature so others hit the early bugs, then take the same automatic fast-forward",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Electron runtime major updates: monthly so the app does not drift into Electron's oldest supported line",
      "matchPackageNames": ["electron"],
      "matchUpdateTypes": ["major"],
      "groupName": "electron runtime major",
      "schedule": ["* 0-4 15 * *"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
