{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Amsterdam",
  "schedule": ["* * * * 0,6"],
  "dependencyDashboard": {
    "enabled": true
  },
  "branchConcurrentLimit": 3,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "automerge": true,
  "automergeType": "branch",
  "automergeStrategy": "fast-forward",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "updateNotScheduled": false,
    "schedule": ["* * * * 0"],
    "minimumReleaseAge": null
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0
  },
  "packageRules": [
    {
      "description": "Non-major updates: one branch for every minor, patch, pin and digest update, so they need one CI run and one landing, and a new dependency joins without a config edit",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Electron runtime patch/minor updates: weekly with a short maturity window because Electron carries Chromium and has a short support cycle",
      "matchPackageNames": ["electron"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "electron runtime non-major",
      "schedule": ["* 0-4 * * 1"],
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Peer-coupled Anthropic and MCP SDKs: their major updates share one branch so they move in lockstep",
      "matchPackageNames": ["@anthropic-ai/**", "@modelcontextprotocol/sdk"],
      "matchUpdateTypes": ["major"],
      "groupName": "llm sdks"
    },
    {
      "description": "Major bumps: wait 30 days for the release to mature so others hit the early bugs, then take the same automatic fast-forward",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Electron runtime major updates: monthly so the app does not drift into Electron's oldest supported line",
      "matchPackageNames": ["electron"],
      "matchUpdateTypes": ["major"],
      "groupName": "electron runtime major",
      "schedule": ["* 0-4 15 * *"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
