{
  "name": "@repo-edu/host-node",
  "private": true,
  "type": "module",
  "dependencies": {
    "@repo-edu/host-runtime-contract": "workspace:*",
    "@repo-edu/integrations-llm": "workspace:*",
    "@repo-edu/integrations-llm-contract": "workspace:*",
    "@repo-edu/tree-sitter-grammar-assets": "workspace:*",
    "koffi": "catalog:",
    "web-tree-sitter": "0.26.12"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./child-process-lifetime": {
      "source": "./src/child-process-lifetime.ts",
      "types": "./dist/child-process-lifetime.d.ts",
      "default": "./dist/child-process-lifetime.js"
    },
    "./examination-archive": {
      "source": "./src/examination-archive/index.ts",
      "types": "./dist/examination-archive/index.d.ts",
      "default": "./dist/examination-archive/index.js"
    },
    "./exclusive-claim": {
      "source": "./src/exclusive-claim.ts",
      "types": "./dist/exclusive-claim.d.ts",
      "default": "./dist/exclusive-claim.js"
    },
    "./llm": {
      "source": "./src/llm.ts",
      "types": "./dist/llm.d.ts",
      "default": "./dist/llm.js"
    },
    "./windows-child-lifetime": {
      "source": "./src/windows-child-lifetime.ts",
      "types": "./dist/windows-child-lifetime.d.ts",
      "default": "./dist/windows-child-lifetime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "check": "pnpm run typecheck",
    "test": "pnpm --filter @repo-edu/tree-sitter-grammar-assets run copy-assets && node --import tsx --test src/__tests__/*.test.ts src/**/__tests__/*.test.ts"
  }
}
