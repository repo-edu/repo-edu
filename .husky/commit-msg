# Derives the severity slot from graded bullets and stamps the capability tag
# and model record, including a step's active time and a ready marker's coder.
# Refuses subjects outside the grammar in
# .agents/references/subject-grammar.md. The parser in
# tools/audit-round/src/subject.ts is the grammar's one reader. Also refuses a
# commit that changes a file tools/audit-round/src/listed-files.json lists for
# this repository unless its subject is a plan step or an implementation-audit
# fix, or it is an off-plan commit with at least one graded bullet and every
# graded bullet at tier D; the hook passes the changed paths, both names of a
# rename included, and the reader asks Git nothing. Git writes a merge's subject, so a merge commit
# is admitted unchecked.
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then exit 0; fi
git diff --cached --name-only --no-renames -z |
  node --import tsx tools/audit-round/src/commit-msg-main.ts repo-edu "$1"
