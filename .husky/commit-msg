#!/usr/bin/env sh
# Stamps and checks the commit's capability tag and model record. The grammar is
# owned by CLAUDE.md under "Commit Capability Tag".

stamped="$1.stamp"
if ! awk '
function shaped(line) {
	return line ~ /^([a-z]+(, [a-z]+)*: )?[A-Za-z0-9][^ ]*( (low|medium|high|xhigh))?$/
}

function bare(token) {
	sub(/:$/, "", token)
	return token
}

function fail(text) {
	printf "commit-msg: %s\n", text > "/dev/stderr"
	exit 1
}

BEGIN {
	efforts["l"] = "low"
	efforts["m"] = "medium"
	efforts["h"] = "high"
	efforts["x"] = "xhigh"
	for (letter in efforts) words[efforts[letter]] = 1
}

{ line[NR] = $0 }

END {
	if (NR == 0) exit 0
	count = split(line[1], tags, " ")
	# A plan form opens the subject and takes the first field, so the tag follows
	# it; an ordinary subject opens with the tag itself.
	slot = tags[1] ~ /\// ? 2 : 1
	if (count < slot) fail("the subject needs a capability tag, as atx")
	tag = bare(tags[slot])

	auditor = ENVIRON["COMMIT_AUDITOR"]
	# An implementation-audit record names the audit, whose capability the round
	# holds and the session composing the subject does not.
	if (auditor != "" && tags[1] ~ /impl-audit-/) {
		tags[slot] = tags[slot] ~ /:$/ ? auditor ":" : auditor
		tag = auditor
		line[1] = tags[1]
		for (at = 2; at <= count; at++) line[1] = line[1] " " tags[at]
	}
	if (tag !~ /^[ao][btu][lmhx]$/)
		fail("the subject needs a capability tag in place of " tag ", as atx")

	phases = ENVIRON["COMMIT_PHASES"]
	first = 0
	for (at = 2; at <= NR; at++)
		if (line[at] != "" && line[at] !~ /^#/) {
			first = at
			break
		}
	# A round states what every phase ran on, so its record replaces whatever the
	# session opened the body with.
	if (phases == "") {
		if (first == 0) fail("the body must open with the model the commit ran on")
		if (!shaped(line[first]))
			fail("the body must open with a model line, not " line[first])
	}
	record = phases == "" ? line[first] : phases

	# One unprefixed record line describes this commit alone, so the two must
	# agree on the effort. A round lists several and states each phase itself, and
	# an audit record names its audit while the record names the fix.
	fields = split(record, said, " ")
	if (tags[1] !~ /impl-audit-/ && record !~ /:/ && said[fields] in words &&
		said[fields] != efforts[substr(tag, 3, 1)])
		fail("the subject tag and the model record disagree on the effort")

	print line[1]
	if (phases == "") {
		for (at = 2; at <= NR; at++) print line[at]
		exit 0
	}
	print ""
	print phases
	at = first == 0 ? NR + 1 : (shaped(line[first]) ? first + 1 : first)
	while (at <= NR && line[at] == "") at++
	if (at <= NR) print ""
	for (; at <= NR; at++) print line[at]
}
' "$1" >"$stamped"; then
	rm -f "$stamped"
	exit 1
fi
mv "$stamped" "$1"
