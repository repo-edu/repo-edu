#!/usr/bin/env sh
# Stamps and checks the commit's capability tag and model record. The grammar is
# owned by CLAUDE.md under "Commit Model Record".

stamped="$1.stamp"
if ! awk '
function shaped(line) {
	return line ~ /^([a-z]+(, [a-z]+)*: )?[A-Za-z0-9][^ ]*( (low|medium|high|xhigh))?$/
}

function bare(token) {
	sub(/:$/, "", token)
	return token
}

function fail(text) {
	printf "commit-msg: %s\n", text > "/dev/stderr"
	exit 1
}

BEGIN {
	efforts["l"] = "low"
	efforts["m"] = "medium"
	efforts["h"] = "high"
	efforts["x"] = "xhigh"
	for (letter in efforts) words[efforts[letter]] = 1
}

{ line[NR] = $0 }

END {
	if (NR == 0) exit 0
	subject = line[1]
	auditor = ENVIRON["COMMIT_AUDITOR"]
	# The round knows the capability the session composing the subject does not,
	# so the assistant letter it wrote is widened into the whole tag here.
	if (auditor != "")
		sub(/impl-audit-(cld|cdx|[ao][0-2]?[lmhx]?)-/, "impl-audit-" auditor "-", subject)
	line[1] = subject

	first = 0
	for (at = 2; at <= NR; at++)
		if (line[at] != "" && line[at] !~ /^#/) {
			first = at
			break
		}
	phases = ENVIRON["COMMIT_PHASES"]
	insert = phases != "" && (first == 0 || !shaped(line[first]))
	if (first == 0 && !insert) fail("the body must open with the model the commit ran on")
	if (!insert && !shaped(line[first]))
		fail("the body must open with a model line, not " line[first])
	record = insert ? phases : line[first]

	# An implementation-audit record carries its tag inside the role token; every
	# other subject carries it as the second tag.
	if (subject ~ /impl-audit-/) {
		if (subject !~ /impl-audit-[ao][0-2][lmhx]-/)
			fail("the audit role token must carry a capability tag, as impl-audit-o2x-")
	} else {
		split(subject, tags, " ")
		tag = bare(tags[2])
		if (tag !~ /^[ao][0-2][lmhx]$/)
			fail("the subject needs a capability tag as its second tag, as a2x")
		# One unprefixed record line describes this commit alone, so the two must
		# agree on the effort. A round lists several and states each phase itself.
		fields = split(record, said, " ")
		if (record !~ /:/ && said[fields] in words &&
			said[fields] != efforts[substr(tag, 3, 1)])
			fail("the subject tag and the model record disagree on the effort")
	}

	print line[1]
	if (insert) {
		print ""
		print phases
	}
	for (at = 2; at <= NR; at++) print line[at]
}
' "$1" >"$stamped"; then
	rm -f "$stamped"
	exit 1
fi
mv "$stamped" "$1"
