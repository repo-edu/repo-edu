{
  "name": "@repo-edu/plan-implementation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@inquirer/prompts": "8.6.0",
    "@openai/codex": "0.149.0",
    "@openai/codex-sdk": "catalog:",
    "@repo-edu/host-node": "workspace:*",
    "cli-truncate": "6.1.1",
    "commander": "^15.0.0",
    "log-update": "8.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "shell-quote": "1.10.0",
    "vscode-jsonrpc": "9.0.1",
    "zod": "4.4.3"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck && pnpm run test:app-server-contract",
    "test:app-server-contract": "node --import tsx --test src/__tests__/codex-app-server-contract.test.ts",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  }
}
